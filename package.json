{
  "name": "forge",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/run.js",
    "native:build": "node scripts/build-www.mjs",
    "native:assets": "node scripts/make-assets.mjs && npx capacitor-assets generate --ios --iconBackgroundColor '#0a0a0b' --splashBackgroundColor '#0a0a0b' --splashBackgroundColorDark '#0a0a0b'",
    "native:setup": "bash scripts/ios-setup.sh",
    "native:sync": "node scripts/build-www.mjs && npx cap sync ios",
    "native:open": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-health": "^8.7.0",
    "sharp": "^0.32.6"
  },
  "engines": {
    "node": ">=22"
  }
}
