rules_version = '2';

// Each user can only read and write their own data under users/{their uid}/{collection}/{id}.
// - Only the collections the app uses are allowed (one level deep; workout sets live inside the workout doc).
// - Every record carries the standard fields; created_at and user_id can't change after creation.
// - Basic type checks per collection.
// - users/{uid}/private/... holds server-only secrets (Withings tokens, Shortcut token hash) and is
//   closed to the app entirely: only Cloud Functions (which bypass rules) can touch it.
// - body_measures, health_daily and integrations are written only by Cloud Functions. You can read them;
//   on body_measures and health_daily you can also delete a record by marking it deleted (a tombstone the
//   sync respects forever) and confirm or reject a flagged weigh-in. Nothing else.
// - oauth_states, withings_users and shortcut_tokens (top level) are server-only.
// No collection-group rules exist, so collection-group queries are denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function allowedCollection(col) {
      return col in ['profile', 'settings', 'locations', 'weights', 'workouts', 'cardio_sessions', 'programs', 'exercises', 'foods', 'food_logs', 'meal_plans'];
    }

    function hasStandardFields(uid, id) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'user_id', 'created_at', 'updated_at', 'source', 'deleted'])
        && d.id == id
        && d.user_id == uid
        && d.created_at is string
        && d.updated_at is string
        && d.source is string
        && d.deleted is bool
        && (!('deleted_at' in d) || d.deleted_at is string);
    }

    // foods and food_logs share these (a log entry holds a copy of the macros per serving).
    function validFoodName(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 80;
    }

    function validMacros(d) {
      return d.kcal is number && d.kcal >= 0 && d.kcal <= 5000
        && d.protein_g is number && d.protein_g >= 0 && d.protein_g <= 500
        && d.carbs_g is number && d.carbs_g >= 0 && d.carbs_g <= 500
        && d.fat_g is number && d.fat_g >= 0 && d.fat_g <= 500;
    }

    // meal_plans/{Monday}: one week of meals (source 'rules' or 'ai'). Rules can't loop over lists, so each day is
    // checked at fixed positions (up to 5 meals a day) and ingredients and steps are checked for count only. The Cloud
    // Function that writes AI plans also checks every string and number before it saves.
    function validMeal(m) {
      return m is map
        && m.keys().hasOnly(['slot', 'id', 'name', 'servings', 'kcal', 'protein_g', 'carbs_g', 'fat_g', 'fish_oz', 'caffeine_mg', 'ingredients', 'steps'])
        && m.name.size() >= 1 && m.name.size() <= 80
        && m.slot in ['breakfast', 'lunch', 'dinner', 'snack1', 'snack2']
        && m.kcal >= 0 && m.kcal <= 5000
        && m.protein_g >= 0 && m.protein_g <= 500
        && m.carbs_g >= 0 && m.carbs_g <= 500
        && m.fat_g >= 0 && m.fat_g <= 500
        && (!('id' in m) || (m.id is string && m.id.size() <= 40))
        && (!('servings' in m) || (m.servings is number && m.servings > 0 && m.servings <= 10))
        && m.ingredients is list && m.ingredients.size() <= 12
        && m.steps is list && m.steps.size() <= 8;
    }

    function validMealAt(meals, i) {
      return meals.size() <= i || validMeal(meals[i]);
    }

    function validDay(day) {
      return day is map && day.keys().hasOnly(['date', 'meals'])
        && day.date is string && day.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && day.meals is list && day.meals.size() <= 5
        && validMealAt(day.meals, 0) && validMealAt(day.meals, 1) && validMealAt(day.meals, 2)
        && validMealAt(day.meals, 3) && validMealAt(day.meals, 4);
    }

    function validMealPlan(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'user_id', 'created_at', 'updated_at', 'source', 'deleted', 'deleted_at', 'weekStart', 'days'])
        && d.source in ['rules', 'ai']
        && d.weekStart is string && d.weekStart == id
        && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(d.weekStart[0:4]), int(d.weekStart[5:7]), int(d.weekStart[8:10])).toMillis() % 604800000 == 345600000
        && d.days is list && d.days.size() == 7
        && validDay(d.days[0]) && validDay(d.days[1]) && validDay(d.days[2]) && validDay(d.days[3])
        && validDay(d.days[4]) && validDay(d.days[5]) && validDay(d.days[6]);
    }

    function validFor(col, id) {
      let d = request.resource.data;
      return (col != 'profile' || (id == 'main' && d.goal is string && d.weightKg is number && d.heightCm is number))
        && (col != 'settings' || id == 'main')
        && (col != 'weights' || (d.kg is number && d.kg > 0 && d.kg < 500 && d.day is string))
        && (col != 'locations' || (d.name is string && d.equipment is list && d.weight_inventory is map))
        && (col != 'workouts' || (d.location_id is string && d.exercises is list && d.started_at is string && d.status is string
              && (!('paused_at' in d) || d.paused_at == null || d.paused_at is string)
              && (!('paused_ms' in d) || (d.paused_ms is number && d.paused_ms >= 0))
              && (!('duration_ms' in d) || (d.duration_ms is number && d.duration_ms >= 0))))
        && (col != 'cardio_sessions' || (d.activity is string && d.duration_min is number && d.started_at is string))
        && (col != 'programs' || (d.template is string && d.started_at is string))
        && (col != 'exercises' || (d.name is string && d.pattern is string && d.equipment is list))
        && (col != 'meal_plans' || validMealPlan(id))
        && (col != 'foods' || (validFoodName(d) && validMacros(d) && d.serving is string && d.serving.size() <= 40))
        && (col != 'food_logs' || (validFoodName(d) && validMacros(d)
              && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && d.meal in ['breakfast', 'lunch', 'dinner', 'snack']
              && d.servings is number && d.servings > 0 && d.servings <= 20
              && (!('food_id' in d) || d.food_id is string)));
    }

    function serverOwned(col) {
      return col in ['body_measures', 'health_daily', 'integrations'];
    }

    // Tombstone / review changes only: deleted can go false → true (never back), deleted_at and
    // reviewed_at are strings, needs_review a bool, and no other field may change.
    function tombstoneOrReview() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deleted_at', 'updated_at', 'needs_review', 'reviewed_at'])
        && d.deleted is bool
        && (d.deleted == true || resource.data.deleted == false)
        && (!('deleted_at' in d) || d.deleted_at is string)
        && (!('reviewed_at' in d) || d.reviewed_at is string)
        && (!('needs_review' in d) || d.needs_review is bool)
        && d.updated_at is string;
    }

    match /users/{uid}/{col}/{id} {
      allow read, delete: if isOwner(uid) && allowedCollection(col);
      allow create: if isOwner(uid) && allowedCollection(col) && hasStandardFields(uid, id) && validFor(col, id);
      allow update: if isOwner(uid) && allowedCollection(col) && hasStandardFields(uid, id) && validFor(col, id)
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.user_id == resource.data.user_id;

      // Written by Cloud Functions only (see the header).
      allow read: if isOwner(uid) && serverOwned(col);
      allow update: if isOwner(uid) && col in ['body_measures', 'health_daily'] && tombstoneOrReview();
    }

    // Explicitly closed (anything not matched above is denied by default too).
    match /users/{uid}/private/{rest=**} {
      allow read, write: if false;
    }
    match /oauth_states/{rest=**} {
      allow read, write: if false;
    }
    match /withings_users/{rest=**} {
      allow read, write: if false;
    }
    match /shortcut_tokens/{rest=**} {
      allow read, write: if false;
    }
  }
}
