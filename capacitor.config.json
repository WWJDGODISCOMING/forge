{
  "appId": "com.christianeverett.forge",
  "appName": "Forge",
  "webDir": "www",
  "backgroundColor": "#040B0E",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true,
    "allowsLinkPreview": false,
    "backgroundColor": "#040B0E",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "LocalNotifications": {
      "presentationOptions": []
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 0,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#040B0E",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
